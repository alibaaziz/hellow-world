# Copiez ce fichier en .env et adaptez-le. Le .env n'est jamais commite.

# ---------------------------------------------------------------- Marche
INTERVAL=15m
CANDLES=200
# Laisser vide pour scanner tous les perpetuels USDT liquides
SYMBOLS=
# 0 = pas de limite; sinon garde les N symboles les plus liquides
MAX_SYMBOLS=0
# Volume 24h minimum en USDT pour qu'un symbole soit scanne
MIN_QUOTE_VOLUME_24H=20000000

# ------------------------------------------------------------------ Scan
SCAN_INTERVAL_SECONDS=60
CONCURRENCY=8

# ----------------------------------------------------------- Indicateurs
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
EMA_FAST=9
EMA_SLOW=21
EMA_TREND=50
BB_PERIOD=20
BB_STD=2.0
ATR_PERIOD=14

# --------------------------------------------------------------- Signaux
# Nombre de regles concordantes exigees (2 = equilibre, 3 = tres selectif)
MIN_SCORE=2
# Delai avant de realerter sur le meme symbole/sens
COOLDOWN_MINUTES=60
ATR_STOP_MULTIPLIER=1.5
RISK_REWARD=2.0

# -------------------------------------------------------------- Telegram
# Vide = alertes console uniquement
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------- Execution
# ATTENTION: TRADING_ENABLED=true + DRY_RUN=false passe de VRAIS ordres.
TRADING_ENABLED=false
DRY_RUN=true
BINANCE_API_KEY=
BINANCE_API_SECRET=
LEVERAGE=3
RISK_PER_TRADE_PCT=1.0
# 0 = lire le solde reel du compte via l'API
ACCOUNT_EQUITY_USDT=0
